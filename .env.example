# Copy to .env and adjust. No real secrets belong in this file or in .env committed to git.

# Ollama endpoint. Bind to loopback only — never 0.0.0.0.
OLLAMA_HOST=127.0.0.1:11434

# API server bind address.
API_HOST=127.0.0.1
API_PORT=8000

# SQLite database file (gitignored).
ECO_DB_PATH=eco.db

# Seconds without a heartbeat before a device is considered stale.
DEVICE_STALE_SECONDS=15
